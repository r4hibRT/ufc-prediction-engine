# PostgreSQL. Either a full connection string, as hosted databases provide...
DATABASE_URL=

# ...or the individual settings (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Hosted databases usually need: require
DB_SSLMODE=

# Model insight paragraphs (optional). The provider and models are set in
# src/engine/voice.py; without a key, narration is skipped.
API_KEY=

# Publishing the static site to Cloudflare Pages (without these, publish is skipped).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PROJECT=ufc-forecast-engine
# The live address, for link previews, e.g. https://ufc-forecast-engine.pages.dev
SITE_URL=

# healthchecks.io ping URL; each successful refresh reports in.
HEALTHCHECK_URL=
